# Google Gemini API Key (Get your free key from https://aistudio.google.com/app/api-keys)
GEMINI_API_KEY=

# Default student display name when joining as guest
STUDENT_NAME=Student

# Preferred summary language (e.g. English, Arabic, Auto)
SUMMARY_LANGUAGE=Auto

# Browser Mode: Set to False if you want to see the browser window while joining, True for headless
HEADLESS=False

# Output directories
RECORDINGS_DIR=recordings
OUTPUT_DIR=output
USER_DATA_DIR=browser_profile
